# V75 Dokploy remote mode is separate from the normal localhost deployment.
# Never set these placeholders in Git; set securely in Dokploy's runtime environment:
# CONTENT_STUDIO_DEPLOY_MODE=dokploy
# CONTENT_STUDIO_PUBLIC_ORIGIN=https://studio.example.com
# CONTENT_STUDIO_AUTH_PASSWORD_SCRYPT=(generate locally via npm run dokploy:credentials:v75)
# CONTENT_STUDIO_AUTH_SESSION_KEY=(generate locally via npm run dokploy:credentials:v75)
# Dokploy requires HOST=0.0.0.0 INSIDE the authenticated private container;
# never expose container ports directly to the public internet.
# V49 local-only production: npm run runtime:preflight before npm start.
# Self-host on localhost. Do NOT enable public access without auth.
# CONTENT_STUDIO_ALLOW_REMOTE=1 and ENABLE_SCENARIO=1 block guarded production startup.
# Never use NEXT_PUBLIC_ prefixes for API keys, access tokens or secrets.
CONTENT_STUDIO_DB_PATH=./data/content-studio.sqlite
ENABLE_SCENARIO=0
# CONTENT_STUDIO_ALLOW_REMOTE=0
# CONTENT_AI_BASE_URL=
# CONTENT_AI_MODEL=
# CONTENT_AI_API_KEY=
# V50: NEXT_PUBLIC_DOOCS_MD_URL is a public URL, never put a secret/token into it.
# npm run doocs:preflight probes loopback root-only GET without sending article content.
# npm run build:preflight rejects populated NEXT_PUBLIC_* key/token/secret fields.
# Optional: locally hosted standalone doocs/md editor. Never paste secrets into its public online demo.
NEXT_PUBLIC_DOOCS_MD_URL=http://127.0.0.1:8800/

# V32 image generator (OpenAI-compatible Images API); never expose these as NEXT_PUBLIC_ vars
# No images are generated until the author explicitly consents on the illustration page.
CONTENT_IMAGE_API_BASE_URL=https://api.openai.com/v1/
CONTENT_IMAGE_MODEL=
CONTENT_IMAGE_API_KEY=

# V33: Illustration Agent — enable only the providers you need. Keys remain server-side.
CONTENT_IMAGE_OPENAI_API_KEY=
CONTENT_IMAGE_OPENAI_MODEL=gpt-image-2
# CONTENT_IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1/
CONTENT_IMAGE_GEMINI_API_KEY=
CONTENT_IMAGE_GEMINI_MODEL=gemini-nano-banana-2.1
# CONTENT_IMAGE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
CONTENT_IMAGE_QWEN_API_KEY=
CONTENT_IMAGE_QWEN_MODEL=qwen-image-3.0
# For Qwen, use the regional/workspace OpenAI-compatible base URL matching your API key.
# CONTENT_IMAGE_QWEN_BASE_URL=https://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1/

# Optional planning LLM (OpenAI-compatible Chat Completions with JSON response)
# Without these, local deterministic visual scene plans still work.
CONTENT_ILLUSTRATION_PLANNER_BASE_URL=
CONTENT_ILLUSTRATION_PLANNER_MODEL=
CONTENT_ILLUSTRATION_PLANNER_API_KEY=

# V34: optional vision-capable reviewer. Image bytes are transmitted ONLY after separate consent.
# Endpoint must support OpenAI-compatible Chat Completions with image_url data URLs.
CONTENT_IMAGE_REVIEW_BASE_URL=
CONTENT_IMAGE_REVIEW_MODEL=
CONTENT_IMAGE_REVIEW_API_KEY=

# V1 author workspaces. Default off preserves the existing local DB.
# CONTENT_STUDIO_MULTIUSER=1
# CONTENT_STUDIO_ACCOUNTS_PATH=/absolute/private/accounts
# Remote registration is closed unless explicitly enabled:
# CONTENT_STUDIO_REGISTRATION_OPEN=0
# Jobs run in the persistent Node process; use this only for maintenance/testing:
# CONTENT_STUDIO_WORKER_DISABLED=0
# Configure encrypted per-author model/image connections in /settings.
