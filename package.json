{
  "name": "content-studio",
  "productName": "Content Studio",
  "version": "0.1.0",
  "description": "A thoughtful creative workspace for independent creators",
  "private": true,
  "type": "module",
  "main": "./out/main/index.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "tokens:generate": "node scripts/design-tokens.mjs",
    "tokens:check": "node scripts/design-tokens.mjs --check",
    "design:check": "pnpm tokens:check && node scripts/check-design.mjs",
    "ux:capture": "node scripts/capture-ux.mjs && node scripts/build-ux-comparison.mjs",
    "format": "prettier --write src config tests *.config.ts components.json",
    "build": "pnpm typecheck && electron-vite build",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:win": "pnpm build && electron-builder --win",
    "test:smoke": "pnpm build && playwright test"
  },
  "dependencies": {
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
