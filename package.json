{
  "name": "content-studio",
  "productName": "Content Studio",
  "version": "0.0.1-alpha.2",
  "description": "A thoughtful creative workspace for independent creators",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --filter @content-studio/desktop dev",
    "start": "pnpm --filter @content-studio/desktop start",
    "dev:web": "pnpm --filter @content-studio/ui dev:web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens:generate": "node scripts/design-tokens.mjs",
    "tokens:check": "node scripts/design-tokens.mjs --check",
    "design:check": "pnpm tokens:check && node scripts/check-design.mjs",
    "ux:capture": "node scripts/capture-ux.mjs && node scripts/build-ux-comparison.mjs",
    "format": "prettier --write packages scripts tests *.config.ts components.json",
    "build": "pnpm typecheck && pnpm --filter @content-studio/desktop build",
    "package:dir": "pnpm --filter @content-studio/desktop package:dir",
    "package:win": "pnpm --filter @content-studio/desktop package:win",
    "test:smoke": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "jsdom": "29.1.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
